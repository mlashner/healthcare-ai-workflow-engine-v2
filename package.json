{
  "name": "carepilot",
  "version": "0.1.0",
  "private": true,
  "description": "CarePilot demonstration care-coordination platform. Fictional data only. Not a medical product.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
